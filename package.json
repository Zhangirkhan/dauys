{
  "name": "voice-mac-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:pwa": "pnpm --filter @voice/pwa dev",
    "dev:server": "tsx apps/server/src/index.ts",
    "dev:agent": "tsx apps/mac-agent/src/index.ts",
    "build": "pnpm --filter @voice/pwa build && tsup apps/server/src/index.ts --format esm --platform node --target node24 --out-dir apps/server/dist --clean && tsup apps/mac-agent/src/index.ts --format esm --platform node --target node24 --out-dir apps/mac-agent/dist --clean && node scripts/fix-node-sqlite.mjs apps/server/dist/index.js apps/mac-agent/dist/index.js",
    "build:agent": "node scripts/build-agent.mjs",
    "build:agent:windows": "node scripts/build-agent.mjs --windows",
    "build:agent:macos": "node scripts/build-agent.mjs --macos",
    "pack:windows-kit": "node scripts/prepare-windows-kit.mjs",
    "pack:windows-transfer": "node scripts/pack-windows-transfer.mjs",
    "start": "node scripts/dev.mjs --production",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup:stt": "node scripts/setup-stt.mjs",
    "setup:parakeet": "node scripts/setup-parakeet.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "openai": "^5.12.0",
    "pino": "^9.8.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4",
    "prettier": "^3.6.2",
    "postject": "1.0.0-alpha.6"
  }
}
