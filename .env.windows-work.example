# Тестовая конфигурация рабочей копии Windows (НЕ production).
# Скопируйте в .env в этой рабочей копии. Не подставляйте токены/БД с боевого сервера.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=./data-windows-work/assistant.db
REGISTRY_PATH=./data-windows-work/registry.json
AGENT_BOOTSTRAP_SECRET=
# Оставьте пустым для mock; для локального intent без облака: INTENT_PROVIDER=local
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
INTENT_PROVIDER=mock
STT_PROVIDER=mock
WHISPER_URL=http://127.0.0.1:9000
MOCK_TRANSCRIPT=Открой Telegram
ALLOW_REAL_ACTIONS=false
ALLOW_REAL_MAC_ACTIONS=false
# На Windows-ПК замените USERNAME и раскомментируйте реальные пути:
# ALLOWED_DIRECTORIES=C:/Users/USERNAME/Documents,C:/Users/USERNAME/Downloads,C:/Users/USERNAME/Projects
ALLOWED_DIRECTORIES=
# ALLOW_UNC_PATHS=true
AGENT_TRUST_PATH=./data-windows-work/agent-trust.json
AGENT_TOKEN_PATH=./data-windows-work/agent-token.json
AGENT_DATA_DIR=./data-windows-work
PWA_ORIGIN=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:8787
COOKIE_SECURE=false
