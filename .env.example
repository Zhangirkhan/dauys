NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=./data/assistant.db
REGISTRY_PATH=./data/registry.json
# Generated by pnpm setup:env; agent bootstrap only, never put in the PWA
AGENT_BOOTSTRAP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set the exact available model identifier from your DeepSeek account
DEEPSEEK_MODEL=
# mock: demo; local: real opening by aliases without a cloud key; deepseek: cloud intent
INTENT_PROVIDER=mock
STT_PROVIDER=mock
WHISPER_URL=http://127.0.0.1:9000
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
PARAKEET_PYTHON=./.venv/bin/python
MOCK_TRANSCRIPT=Давай поработаем над OTP
WHISPER_MODEL=base
WHISPER_LANGUAGE=ru
WHISPER_PYTHON=./.venv/bin/python
ALLOW_REAL_MAC_ACTIONS=false
# Alias: ALLOW_REAL_ACTIONS=true|false (приоритетнее ALLOW_REAL_MAC_ACTIONS)
# Windows example:
# ALLOWED_DIRECTORIES=C:/Users/USERNAME/Documents,C:/Users/USERNAME/Downloads,C:/Users/USERNAME/Projects
ALLOWED_DIRECTORIES=/Users/USERNAME/Documents,/Users/USERNAME/Downloads,/Users/USERNAME/Projects
# ALLOW_UNC_PATHS=true  # only if you explicitly need network paths on Windows
AGENT_TRUST_PATH=./data/agent-trust.json
AGENT_TOKEN_PATH=./data/agent-token.json
PWA_ORIGIN=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:8787
COOKIE_SECURE=false
